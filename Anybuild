load("//anybuild/tools:php.bzl", "php_build", "php_config", "php_serve")

config = php_config(
    schema = 1,
    commands = {"after_deploy": "php artisan migrate --force --seed"},
    php_version = "8.3.29",
    php_public_dir = "public",
    composer_enable = True,
    composer_build_script = "post-update-cmd",
    phpix = True,
)

build = php_build(config)

php_serve(
    config,
    build,
    name = "capstoneproject2026-test",
    build_pre = [
        copy("composer.json", "/app/composer.json"),
        copy("composer.lock", "/app/composer.lock"),
    ],
)
