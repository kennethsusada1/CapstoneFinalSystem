# Custom Laravel build definition for Wasmer.
# The frontend dependencies are needed only while Vite compiles the assets;
# removing them before export keeps the runtime package within Wasmer's build limit.
load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config", "laravel_serve")

config = laravel_config(
    schema = 1,
    node_package_manager = "pnpm",
    node_build_command = "pnpm run build",
    node_version = "24",
    php_framework = "laravel",
    php_version = "8.3.29",
    php_public_dir = "public",
    composer_enable = True,
    composer_build_script = "post-update-cmd",
)

build = laravel_build(config)

laravel_serve(
    config,
    build,
    name = "capstoneproject2026-test",
    commands = {"after_deploy": "php artisan migrate --force"},
    build_post = [run("rm -rf node_modules", group = "build")],
)
